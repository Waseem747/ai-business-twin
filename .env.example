# ================= AI Business Twin =================
APP_ENV=development
APP_NAME=AI Business Twin
APP_BASE_URL=http://localhost:8000
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:4173

# ---------- PostgreSQL (Docker Compose) ----------
POSTGRES_USER=twin
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=business_twin

# ---------- Persistence ----------
# Local MVP uses SQLite. Docker compose overrides this with PostgreSQL + pgvector.
DATABASE_URL=sqlite+aiosqlite:///./data/runtime/business_twin.db
# DATABASE_URL=postgresql+asyncpg://twin:twin@localhost:5432/business_twin
CHECKPOINT_DB=./data/runtime/checkpoints.sqlite
STORAGE_DIR=./storage

# ---------- Auth (CHANGE IN PRODUCTION) ----------
JWT_SECRET=dev-only-change-me-please-32-chars-minimum
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=480
COOKIE_SECURE=false
# Independent key for at-rest connector credential encryption. Falls back to JWT_SECRET if empty.
CREDENTIAL_ENCRYPTION_KEY=

# ---------- Demo ----------
DEMO_MODE=true
# Runs the daily, decision and Excel demo workflows once on a fresh database.
DEMO_AUTO_BOOTSTRAP=true

# ---------- Model gateway ----------
# deterministic = local, no LLM; openai = cloud; ollama = local LLM
LLM_PROVIDER=deterministic
LLM_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=business-twin

# ---------- Scheduling ----------
SCHEDULER_ENABLED=true
DAILY_REPORT_CRON_HOUR=7
DAILY_REPORT_CRON_MINUTE=0
TIMEZONE=UTC

# ---------- Governance ----------
HUMAN_APPROVAL_THRESHOLD_USD=5000
MAX_AUDIT_ROUNDS=2
SANDBOX_TIMEOUT_SECONDS=8
DATA_STALE_AFTER_HOURS=48

# ---------- Optional integrations (never committed) ----------
# SQL source secret references. Configure a read-only database role.
ANALYTICS_DATABASE_URL=
# Google Sheets read access (public link-shared sheets need neither)
GOOGLE_SHEETS_API_KEY=
GOOGLE_SERVICE_ACCOUNT_JSON=
# Generic REST/GraphQL bearer token reference
VENDOR_API_TOKEN=
POS_API_BASE_URL=
POS_API_TOKEN=
ERP_API_BASE_URL=
ERP_API_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_EMAIL_TO=
